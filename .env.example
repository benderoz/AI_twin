# Copy this to .env and fill values
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME
# Timezone for reports, e.g. Europe/Moscow
APP_TZ=Europe/Moscow
# Use webhook or polling: webhook|polling
RUN_MODE=polling
# Public URL for webhooks (only if RUN_MODE=webhook)
PUBLIC_URL=